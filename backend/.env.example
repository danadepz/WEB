# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Firebase Admin Configuration (Use environment variables or service account JSON path)
FIREBASE_PROJECT_ID=ucb-intramurals
FIREBASE_CLIENT_EMAIL=your-service-account-email@ucb-intramurals.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account-key.json
